<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.vlad-public-code</groupId>
        <artifactId>valem</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>valem-core</artifactId>
    <name>valem-core</name>
    <description>Valem core runtime — no Spring dependency</description>

    <dependencies>
        <dependency>
            <groupId>io.github.vlad-public-code</groupId>
            <artifactId>tracked-json</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.vlad-public-code</groupId>
            <artifactId>jsonata-jvm-compiler</artifactId>
        </dependency>
<dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Excel-to-spec (excel-to-spec-v1-design.md §2.1): the real XSSFWorkbook-backed CellGrid
             adapter and its formula evaluator (the independent correctness oracle, AC-4). Shared by
             the REST surface (valem-api) and the MCP convert_spreadsheet tool (valem-mcp), so it
             lives here rather than in either module, same placement rationale as the PDF/DOCX
             extractors in the sibling document-to-spec feature. Apache-2.0, pure-Java, no external
             service; previously approved for the same purpose (PDF/DOCX text extraction) in this
             codebase's document-to-spec work. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
