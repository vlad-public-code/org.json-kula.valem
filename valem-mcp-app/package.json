    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "valem-view-react": "*"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^2.1.9"
  }
}
