{
  "_name": "Order / Line Items",
  "_description": "Items array with per-row lineTotal and grand total derived via JSONata, edited inline in an editableTable.",
  "id": "order-items-price-total",
  "version": "1.0.0",
  "schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name":      { "type": "string" },
            "price":     { "type": "number", "minimum": 0, "multipleOf": 0.01 },
            "qty":       { "type": "integer", "minimum": 1 },
            "lineTotal": { "type": "number", "readOnly": true }
          },
          "required": ["name", "price", "qty"]
        }
      },
      "total": { "type": "number", "readOnly": true, "multipleOf": 0.01 }
    }
  },
  "derivations": [
    {
      "path": "$.total",
      "expr": "$count(items) > 0 ? ($count(items[price != null and qty != null]) > 0 ? $sum(items[price != null and qty != null].(price * qty)) : 0) : 0"
    },
    {
      "path": "$.items[*].lineTotal",
      "expr": "$parent.price != null and $parent.qty != null ? $parent.price * $parent.qty : 0"
    }
  ],
  "constraints": [
    {
      "id": "non-negative-total",
      "expr": "total >= 0",
      "message": "Total must be non-negative",
      "policy": "rollback"
    }
  ],
  "actions": [],
  "metaDerivations": [],
  "viewDefinition": {
    "renderer": "builtin",
    "defaultView": "main",
    "views": [
      {
        "id": "main",
        "label": "Order",
        "layout": "vertical",
        "components": [
          {
            "id": "itemsTable",
            "type": "editableTable",
            "label": "Order Items",
            "bind": "$.items",
            "canAdd": true,
            "canRemove": true,
            "addLabel": "Add Item",
            "removeLabel": "Remove",
            "emptyText": "No items yet. Add one to start the order.",
            "rowHeader": {
              "header": "Product",
              "width": "34%",
              "components": [
                {
                  "id": "itemName",
                  "type": "textField",
                  "bind": "$.items[*].name",
                  "placeholder": "e.g. Apple"
                }
              ]
            },
            "gridColumns": [
              {
                "id": "price",
                "header": "Unit Price",
                "width": "22%",
                "components": [
                  {
                    "id": "itemPrice",
                    "type": "currencyField",
                    "bind": "$.items[*].price",
                    "currency": "USD",
                    "placeholder": "0.00"
                  }
                ]
              },
              {
                "id": "qty",
                "header": "Qty",
                "width": "16%",
                "components": [
                  {
                    "id": "itemQty",
                    "type": "numericField",
                    "bind": "$.items[*].qty",
                    "placeholder": "1"
                  }
                ]
              },
              {
                "id": "lineTotal",
                "header": "Line Total",
                "width": "18%",
                "align": "right",
                "components": [
                  {
                    "id": "itemLineTotal",
                    "type": "label",
                    "bind": "$.items[*].lineTotal",
                    "format": "currency",
                    "currency": "USD"
                  }
                ]
              }
            ]
          },
          {
            "id": "sep1",
            "type": "separatorLine"
          },
          {
            "id": "totalRow",
            "type": "group",
            "layout": "horizontal",
            "components": [
              {
                "id": "totalLabel",
                "type": "statTile",
                "label": "Grand Total",
                "bind": "$.total",
                "format": "currency",
                "currency": "USD"
              }
            ]
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "description": "total and per-item lineTotal are derived from price x qty",
      "given": {
        "$.items[0].name":  "Apple",
        "$.items[0].price": 1.5,
        "$.items[0].qty":   4,
        "$.items[1].name":  "Bread",
        "$.items[1].price": 2.75,
        "$.items[1].qty":   2
      },
      "expect": {
        "$.total":               11.5,
        "$.items[0].lineTotal":  6,
        "$.items[1].lineTotal":  5.5
      }
    }
  ]
}
