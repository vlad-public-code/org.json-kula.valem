{
  "name": "@valem/embed",
  "version": "1.0.0",
  "description": "Embed a single live, interactive Valem model into any web page or React app — a copy-paste iframe or a native <ValemModel> component.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "vlad-public-code (https://github.com/vlad-public-code)",
  "homepage": "https://github.com/vlad-public-code/org.json-kula.valem/tree/main/clients/valem-embed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlad-public-code/org.json-kula.valem.git",
    "directory": "clients/valem-embed"
  },
  "bugs": {
    "url": "https://github.com/vlad-public-code/org.json-kula.valem/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": ["valem", "embed", "iframe", "react", "reactive", "jsonata", "widget"],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
